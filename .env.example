# ============================================================================
# EDS Avatar BFF Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
# Host interface to bind to. MUST be loopback (127.0.0.1 or ::1) - the service
# refuses to start otherwise. The bb-auth gate authenticates callers by injecting an
# identity header, which is only trustworthy while the reverse proxy that sets it is
# the sole reachable path to this port.
HOST=127.0.0.1

# Port number for the BFF server (1-65535)
PORT=3001

# Runtime environment (development, production, test)
NODE_ENV=development

# Logging level (trace, debug, info, warn, error, fatal)
# Default: 'debug' in development, 'info' in production
# - trace: Most verbose, includes all debug info and trace-level details
# - debug: Detailed debugging information (recommended for development)
# - info: General informational messages (recommended for production)
# - warn: Warning messages for potentially harmful situations
# - error: Error messages for failures that need attention
# - fatal: Critical errors that may cause the application to stop
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Authentication (bb-auth reverse-proxy gate)
# ----------------------------------------------------------------------------
# This service verifies no token. nginx runs an `auth_request` against the bb-auth
# gate and injects the authorized email into the proxied request; that header is the
# credential. nginx overwrites it on every request it forwards, so a client cannot
# supply its own - provided nothing can reach this port except nginx (see HOST).
#
# Must match the name nginx sets with proxy_set_header in the gated location.
GATE_IDENTITY_HEADER=x-auth-email

# The gate also forwards the user's names when the id token carries the `given_name` /
# `family_name` claims. They are percent-encoded, since header values are not UTF-8,
# and they are optional: a missing header simply leaves the name unset. They never
# grant access - only GATE_IDENTITY_HEADER does.
GATE_GIVEN_NAME_HEADER=x-auth-given-name
GATE_FAMILY_NAME_HEADER=x-auth-family-name

# ----------------------------------------------------------------------------
# Deepgram Configuration
# ----------------------------------------------------------------------------
# Deepgram API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Optional: Explicit Deepgram Project ID
# If not set, the BFF will automatically use the first project from your account
# Format: 8-character hex string (e.g., 12345678)
# Get from: https://console.deepgram.com/ > Project Settings > Project ID
# DEEPGRAM_PROJECT_ID=

# Token time-to-live in minutes (1-1440 = 1min-24hours)
# 15 = 15 minutes
DEEPGRAM_TOKEN_TTL_MINUTES=15

# ----------------------------------------------------------------------------
# Rate Limiting Configuration
# ----------------------------------------------------------------------------
# Rate limit window in milliseconds (60000-3600000 = 1min-1hour)
# 900000 = 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (1-1000)
# 100 = 100 requests per 15 minutes
RATE_LIMIT_MAX_REQUESTS=100